// DB Provisioner — Prisma schema
//
// This database is the application's OWN metadata store. It is separate from the
// PostgreSQL servers the app provisions into (those are reached via the
// POSTGRES_*_URL admin connection strings).
//
// IMPORTANT: passwords are NEVER stored here. See ProvisionedDatabase.

generator client {
  provider      = "prisma-client-js"
  // `native` for local dev; the debian target matches the node:20-bookworm-slim
  // base image used in the Dockerfile / Coolify deploy.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User-defined environments. The stable `key` is referenced by other tables
/// via foreign keys with onDelete: Restrict, so an environment in use cannot be
/// deleted. `name`/color/flags are freely editable; `key` never changes.
model Environment {
  key                 String   @id
  name                String
  description         String?
  color               String   @default("slate")
  abbreviation        String?
  sortOrder           Int      @default(0) @map("sort_order")
  readOnly            Boolean  @default(false) @map("read_only")
  requireWriteConfirm Boolean  @default(true) @map("require_write_confirm")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  provisionedDatabases ProvisionedDatabase[]
  queryHistory         QueryHistory[]

  @@map("environments")
}

/// One row per (database, server) the app has provisioned.
model ProvisionedDatabase {
  id              String      @id @default(cuid())
  applicationName String      @map("application_name")
  environment     String
  environmentRef  Environment @relation(fields: [environment], references: [key], onDelete: Restrict)
  databaseName    String      @map("database_name")
  username        String
  host            String
  // Passwords are intentionally NOT stored. The connection string with a
  // password is shown exactly once, on the creation success screen.
  createdAt       DateTime    @default(now()) @map("created_at")
  createdBy       String      @default("system") @map("created_by")
  notes           String?

  // A given database name is unique per environment/host pairing.
  @@unique([environment, host, databaseName], name: "env_host_db")
  @@index([applicationName])
  @@index([databaseName])
  @@index([username])
  @@map("provisioned_databases")
}

/// One row per executed SQL Console query. Stores metadata only — never
/// connection strings or passwords. The query text itself IS stored so admins
/// can review/re-run from history.
model QueryHistory {
  id              String      @id @default(cuid())
  environment     String
  environmentRef  Environment @relation(fields: [environment], references: [key], onDelete: Restrict)
  databaseName    String      @map("database_name")
  query           String
  queryType       String      @map("query_type")
  executionTimeMs Int?        @map("execution_time_ms")
  success         Boolean
  errorMessage    String?     @map("error_message")
  executedAt      DateTime    @default(now()) @map("executed_at")

  @@index([executedAt])
  @@index([environment])
  @@map("query_history")
}

/// User-saved queries that appear in the console sidebar (alongside the
/// built-in admin query library).
model SavedQuery {
  id          String   @id @default(cuid())
  name        String
  description String?
  query       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("saved_queries")
}

/// Future-ready: encrypted key/value settings (e.g. editable connection
/// strings, Coolify tokens). Not wired into the runtime in v1 — connection
/// strings are sourced from environment variables — but the table and the
/// AES-256-GCM crypto helper exist so this can be enabled without a migration
/// rewrite. Values are stored encrypted via `src/lib/crypto.ts`.
model Setting {
  key            String   @id
  encryptedValue String   @map("encrypted_value")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// User-managed encrypted vault for arbitrary credentials (API tokens,
/// passwords, connection strings, SSH keys). Distinct from the app-internal
/// `Setting` store: these are surfaced and managed in the Secrets module UI.
/// The plaintext value is encrypted at rest (AES-256-GCM, `src/lib/crypto.ts`)
/// and is only ever returned through the explicit reveal path.
model Secret {
  id             String    @id @default(cuid())
  name           String    @unique
  description    String?
  category       String
  encryptedValue String    @map("encrypted_value")
  lastRevealedAt DateTime? @map("last_revealed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([name])
  @@map("secrets")
}
