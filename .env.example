# ─────────────────────────────────────────────────────────────────────────────
# Aspyre Labs Infrastructure Manager (ALIM): environment configuration
#
# Copy to `.env` and fill in. In Coolify, set these as environment variables on
# the service. NONE of these values are ever shown to end users in the UI.
#
# MINIMUM TO RUN (with the default password auth mode):
#   1. DATABASE_URL   — the app's own metadata DB (docker-compose default works).
#   2. AUTH_PASSWORD  — the shared sign-in password; the app refuses to serve
#                       any page until this is set.
#   3. AUTH_SECRET    — key that signs session cookies (or set ENCRYPTION_KEY).
#                       Generate one with:
#                         node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Everything else is optional / per-integration.
# ─────────────────────────────────────────────────────────────────────────────

# The application's OWN metadata database (registry + settings).
# This is NOT one of the servers you provision into — it is the app's storage.
# When using the bundled docker-compose, this points at the `appdb` service.
DATABASE_URL="postgresql://dbprovisioner:dbprovisioner@localhost:5432/dbprovisioner?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Admin connection strings for the PostgreSQL servers you provision INTO.
#
# Environments are now user-defined and managed on the in-app Settings page,
# where connection strings (stored AES-256-GCM encrypted, requires
# ENCRYPTION_KEY) AND read-only / write-confirm behavior are configured per
# environment. The POSTGRES_*_URL vars below are an OPTIONAL legacy fallback,
# used only for the original three environments when no connection string has
# been saved in Settings for that environment.
#
# These must be SUPERUSER (or at least CREATEDB + CREATEROLE) connections,
# typically to the maintenance `postgres` database on each server.
# The app connects with these to run CREATE USER / CREATE DATABASE / GRANT.
#
# Format: postgresql://<admin_user>:<admin_password>@<host>:<port>/postgres
#
# Leave any of them blank to manage that environment from the Settings page.
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_PROD_URL=""
POSTGRES_STAGING_URL=""
POSTGRES_DEV_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# 32-byte key used by the AES-256-GCM helper (src/lib/crypto.ts) for the
# future-ready encrypted Settings store. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Accepts a base64 (44 char) or hex (64 char) encoded 32-byte key.
# Optional in v1 (Settings is read-only), but required to enable encrypted
# settings later.
# ─────────────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION
#
# ALIM is secure-by-default: there is NO unauthenticated ("none") mode. Pick a
# mode with AUTH_MODE:
#
#   password : a single shared password gate with a signed session cookie.
#   proxy    : trust an identity header set by a reverse proxy that has already
#              authenticated the user (Cloudflare Access, Authelia, Authentik,
#              oauth2-proxy, ...). No password is used.
#   both     : accept EITHER — SSO via the proxy normally, with the shared
#              password as a break-glass fallback if the proxy is bypassed.
#
# Defaults to "password". If a password-bearing mode is set without the inputs
# it needs (AUTH_PASSWORD + a signing secret), the gate FAILS CLOSED and denies
# every request until you fix it.
# ─────────────────────────────────────────────────────────────────────────────
AUTH_MODE="password"

# Shared gate password (required for "password" and "both").
AUTH_PASSWORD=""

# Username recorded in the audit log for password sessions. Attribution only —
# it is NOT a second credential. The login form prefills it and operators may
# override it to identify themselves while sharing the one password.
AUTH_ADMIN_USERNAME="admin"

# HMAC key used to sign session cookies. Falls back to ENCRYPTION_KEY when unset.
# Required whenever AUTH_MODE includes "password".
AUTH_SECRET=""

# Session lifetime. Plain seconds or a suffixed value: 30m, 12h, 7d. Default 7d.
AUTH_SESSION_TTL="7d"

# ── Reverse-proxy mode (AUTH_MODE includes "proxy") ──────────────────────────
# Request header carrying the proxy-authenticated identity (usually an email).
AUTH_PROXY_HEADER="X-Forwarded-User"

# SECURITY: header trust is only safe if ALIM is reachable EXCLUSIVELY through
# the proxy — otherwise anyone who can reach the port can forge the header. If
# the port might be directly reachable, set a shared secret here that your proxy
# must also send (in the x-alim-proxy-secret header); requests without it are
# rejected. Leave blank to disable.
AUTH_PROXY_SHARED_SECRET=""

# Label attributed to provisioning/audit actions when no authenticated user is
# present (e.g. scripts / non-request contexts). In normal use the real
# authenticated identity is recorded instead.
PROVISIONED_BY="internal-admin"

# ─────────────────────────────────────────────────────────────────────────────
# Coolify integration (Phase 2). Preferred path is to set these in the in-app
# Settings page (stored AES-256-GCM encrypted, requires ENCRYPTION_KEY). These
# env vars are an optional fallback used only when no in-app value is set.
#   COOLIFY_BASE_URL: root URL of your Coolify instance (no trailing /api/v1)
#   COOLIFY_API_TOKEN: a Coolify API token with application permissions
# ─────────────────────────────────────────────────────────────────────────────
COOLIFY_BASE_URL=""
COOLIFY_API_TOKEN=""
