# ─────────────────────────────────────────────────────────────────────────────
# DB Provisioner — environment configuration
#
# Copy to `.env` and fill in. In Coolify, set these as environment variables on
# the service. NONE of these values are ever shown to end users in the UI.
# ─────────────────────────────────────────────────────────────────────────────

# The application's OWN metadata database (registry + settings).
# This is NOT one of the servers you provision into — it is the app's storage.
# When using the bundled docker-compose, this points at the `appdb` service.
DATABASE_URL="postgresql://dbprovisioner:dbprovisioner@localhost:5432/dbprovisioner?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Admin connection strings for the PostgreSQL servers you provision INTO.
#
# These must be SUPERUSER (or at least CREATEDB + CREATEROLE) connections,
# typically to the maintenance `postgres` database on each server.
# The app connects with these to run CREATE USER / CREATE DATABASE / GRANT.
#
# Format: postgresql://<admin_user>:<admin_password>@<host>:<port>/postgres
#
# Leave any of them blank if that environment is not configured — the matching
# target simply shows as "not configured" in the UI.
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_PROD_URL=""
POSTGRES_STAGING_URL=""
POSTGRES_DEV_URL=""

# SQL Query Console: hard-disable ALL write/DDL/DML operations against the
# Production server (SELECT/EXPLAIN/SHOW still allowed). Truthy: 1/true/yes/on.
# Leave blank to allow writes on Production behind the typed-CONFIRM modal.
POSTGRES_PROD_READONLY=""

# ─────────────────────────────────────────────────────────────────────────────
# 32-byte key used by the AES-256-GCM helper (src/lib/crypto.ts) for the
# future-ready encrypted Settings store. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Accepts a base64 (44 char) or hex (64 char) encoded 32-byte key.
# Optional in v1 (Settings is read-only), but required to enable encrypted
# settings later.
# ─────────────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=""

# Label attributed to provisioning actions in the registry (audit field).
# With no auth in v1 this is a static, configurable value.
PROVISIONED_BY="internal-admin"
